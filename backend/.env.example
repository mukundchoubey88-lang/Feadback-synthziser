# Application Configuration
APP_NAME="Feedback Intelligence API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api

# Database Configuration (PostgreSQL with psycopg v3 driver)
# Format: postgresql+psycopg://username:password@localhost:5432/feedback_db
DATABASE_URL=

# AI Provider Configuration (Part 5 & Part 5.1)
# Primary: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Secondary: OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_FALLBACK_MODELS=anthropic/claude-3.5-haiku,meta-llama/llama-3.3-70b-instruct

# Tertiary: xAI Grok
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Multi-Provider Orchestration & Failover
AI_PRIMARY_PROVIDER=gemini
AI_PROVIDER_FALLBACK_ENABLED=true
AI_PROVIDER_PRIORITY=gemini,openrouter,grok
AI_REQUEST_TIMEOUT=30.0
AI_PROVIDER_MAX_RETRIES=2
AI_PROVIDER_COOLDOWN_SECONDS=60

# AI Embedding Configuration (Part 7)
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=768
AI_EMBEDDING_TIMEOUT=30.0
AI_EMBEDDING_MAX_RETRIES=2

# Theme Clustering Configuration (Part 7 Step 4)
THEME_CLUSTERING_SIMILARITY_THRESHOLD=0.80
THEME_CLUSTERING_MIN_CLUSTER_SIZE=3
THEME_CLUSTERING_MAX_BATCH_SIZE=150
THEME_CLUSTERING_REPRESENTATIVE_COUNT=3

# Hindsight Persistent Memory Configuration (Part 9)
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=

# Upload Safeguards (Part 3.1)
MAX_UPLOAD_FILE_SIZE_BYTES=10485760
MAX_UPLOAD_RECORDS=10000
MAX_FEEDBACK_TEXT_LENGTH=10000

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173
