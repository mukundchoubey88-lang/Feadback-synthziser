# Application Configuration
APP_NAME="Feedback Intelligence API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api

# Database Configuration (PostgreSQL with psycopg v3 driver)
# Format: postgresql+psycopg://username:password@localhost:5432/feedback_db
DATABASE_URL=

# Gemini AI Configuration (Part 4)
GEMINI_API_KEY=

# Hindsight Persistent Memory Configuration (Part 9)
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173
